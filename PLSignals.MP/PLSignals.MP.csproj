<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AssemblyName>PLSignals.MP</AssemblyName>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	<!-- NuGet packages -->
	<ItemGroup>
		<PackageReference Include="DVMultiplayerAPI" Version="1.1.0" />
	</ItemGroup>

	<!-- PLSignals.Game for the IPLMPIntegration interface -->
	<ItemGroup>
		<ProjectReference Include="..\PLSignals.Game\PLSignals.Game.csproj" />
	</ItemGroup>

	<!-- Game DLL references (paths resolved via Directory.Build.targets ReferencePath) -->
	<ItemGroup>
		<Reference Include="Assembly-CSharp" />
		<Reference Include="DV.Utils" />
		<Reference Include="DV.RailTrack" />
		<Reference Include="UnityModManager" />
		<Reference Include="UnityEngine.CoreModule" />
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<!-- Copy to build folder -->
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="../build/" />
	</Target>
</Project>